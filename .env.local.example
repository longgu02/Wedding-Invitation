MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=wedding

# Domain thật khi deploy — để Facebook/Zalo lấy được ảnh preview (URL tuyệt đối).
# Ví dụ: https://thiepcuoi-tuanlong-khanhchi.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Tuỳ chọn) đổi DNS resolver nếu mạng chặn SRV lookup của mongodb+srv
# MONGODB_DNS=8.8.8.8,1.1.1.1
